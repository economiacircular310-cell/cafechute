# Copia este archivo como .env y rellena los valores.
SECRET_KEY=            # python manage.py secret-key
SITE_URL=https://www.cafechute.com
FORCE_HTTPS=1          # 0 solo en local sin HTTPS

# Panel /admin (python manage.py hash-password)
ADMIN_PASSWORD_HASH=

# Datos legales (se muestran solo si están definidos)
RNT_NUMBER=            # Registro Nacional de Turismo — obligatorio en la publicidad turística
LEGAL_NAME=Casa Chute – Café Chute
LEGAL_ID=              # NIT o cédula del responsable de los datos

# Precio de la bolsa de 500 g en COP. Vacío = "pide precio por WhatsApp"
COFFEE_PRICE_COP=

# Reputación en Google (actualizar periódicamente)
GOOGLE_RATING=4,9
GOOGLE_REVIEWS=10

# Google Analytics 4 (vacío = sin analítica y sin banner de cookies)
GA4_ID=

# Clima en vivo de la finca (Open-Meteo, sin clave). 0 para desactivar
LIVE_WEATHER=1
